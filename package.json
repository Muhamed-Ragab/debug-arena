{
  "name": "debug-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.9.0",
  "scripts": {
    "dev": "lingui compile --typescript && next dev",
    "build": "lingui compile --typescript && next build",
    "start": "next start",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "lint:sort": "biome check --unsafe --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:bruno": "bru run bruno --env local",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:migrate:prod": "tsx --env-file=.env.prod src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:seed:prod": "tsx --env-file=.env.prod src/db/seed.ts",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.33",
    "@base-ui/react": "^1.7.0",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@better-auth/redis-storage": "^1.7.1",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.69.0",
    "ai": "^7.0.83",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "0.45.2",
    "ioredis": "^5.6.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "next-safe-action": "^8.6.1",
    "pg": "^8.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.4.0",
    "validation-better-auth": "^1.3.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@lingui/cli": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@usebruno/cli": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.1",
    "jsdom": "^26.0.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "ultracite": "^7.10.6",
    "vitest": "^3.1.1"
  }
}
