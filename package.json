{
  "name": "debug-arena",
  "private": true,
  "version": "0.1.0",
  "description": "Debug Arena — a LeetCode-style platform for root-cause bug diagnosis instead of algorithm writing",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @debug-arena/db generate",
    "db:migrate": "pnpm --filter @debug-arena/db migrate",
    "db:studio": "pnpm --filter @debug-arena/db studio",
    "fmt": "turbo run fmt",
    "fmt:check": "turbo run fmt:check"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.10.11",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=20"
  }
}
