meta {
  name: Get Challenge By ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/challenges/{{challengeId}}
  body: none
  auth: none
}

assert {
  res.status: in [200, 307, 308, 404]
}

tests {
  test("Challenge dynamic page responds with valid status", function() {
    expect([200, 307, 308, 404]).to.include(res.getStatus());
  });
}
