meta {
  name: Get Submission Results
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/submissions/{{submissionId}}/results
  body: none
  auth: none
}

assert {
  res.status: in [200, 307, 308, 404]
}

tests {
  test("Submission results page responds with valid status", function() {
    expect([200, 307, 308, 404]).to.include(res.getStatus());
  });
}
