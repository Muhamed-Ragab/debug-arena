# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/debug_arena
# Redis (secondary session storage + future BullMQ)
REDIS_URL=redis://localhost:6379
# better-auth
BETTER_AUTH_SECRET=change-me-32+-random-chars
