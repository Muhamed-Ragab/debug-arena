# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/debug_arena

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- AI ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Sandbox runner ---
SANDBOX_IMAGE=debug-arena-sandbox:latest
SANDBOX_TIMEOUT_MS=10000

# --- better-auth ---
BETTER_AUTH_SECRET=change-me-32+-random-chars
# Optional: absolute origin used in emails/redirects; leave unset for local dev
# BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
