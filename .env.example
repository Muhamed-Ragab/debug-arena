# OAuth (both keys of a pair required to enable that provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# AI Evaluation (Groq API - free tier Llama 3.3 70B & Llama 3.1 8B)
GROQ_API_KEY=
